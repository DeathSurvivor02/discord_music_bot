# Discord Bot Token from Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Spotify API Credentials from Spotify Developer Dashboard (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Default prefix for traditional commands (Slash commands /play are also enabled)
BOT_PREFIX=!

# AI DJ Settings (Optional: Gemini generates dynamic radio scripts, fallback templates used if empty)
GEMINI_API_KEY=
DJ_ENABLED=true
DJ_NAME="DJ X"
DJ_VOICE=en-US-ChristopherNeural
DJ_FREQUENCY=2
